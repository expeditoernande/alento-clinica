# Banco de dados. A Vercel injeta POSTGRES_URL ao conectar um Postgres (Neon) no
# projeto. Sem ela, o dev local grava em .alento-data.json e a Vercel usa memória.
POSTGRES_URL=

# Segredo para assinar o cookie de sessão. Em produção é obrigatório: sem ele as
# sessões não sobrevivem entre instâncias. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# URL pública do site (usada em metadataBase, sitemap e links absolutos).
SITE_URL=

# E-mails transacionais (verificação, redefinição de senha). Sem a chave, o
# envio é ignorado e as contas são verificadas automaticamente.
RESEND_API_KEY=
EMAIL_FROM=

# Integração com o Google Agenda (OAuth 2.0), uma conta por psicólogo.
# Crie credenciais OAuth no Google Cloud Console (tipo "Web application") e
# cadastre a URL de redirecionamento:
#   https://SEU-DOMINIO/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Provedor de agenda usado para ler ocupados/criar eventos. Opções:
#   (vazio) -> "google" (ou "api" se AGENDA_API_URL estiver definido)
#   google  -> Google Agenda (OAuth acima)
#   api     -> uma API HTTP externa (ex.: a agenda do parceiro)
#   mock    -> agenda simulada em memória, só para desenvolvimento/teste
AGENDA_PROVIDER=

# Quando AGENDA_PROVIDER=api, aponta para a agenda externa. O contrato esperado:
#   GET    {AGENDA_API_URL}/busy?from=<ISO>&to=<ISO>  -> ocupados
#   POST   {AGENDA_API_URL}/events                     -> cria, devolve { id }
#   DELETE {AGENDA_API_URL}/events/{id}                -> remove
AGENDA_API_URL=
AGENDA_API_KEY=
AGENDA_BUSY_PATH=
AGENDA_EVENTS_PATH=

# Quando AGENDA_PROVIDER=mock, semeia ocupações iniciais (JSON de intervalos ISO):
#   AGENDA_MOCK_BUSY=[{"start":"2026-10-15T13:00:00-03:00","end":"2026-10-15T14:00:00-03:00"}]
AGENDA_MOCK_BUSY=
